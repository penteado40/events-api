generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  USER
}

enum GroupRole {
  OWNER
  VIEWER
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  phone       String // E.164 with the country code; contact only, never sign-in
  clerkId     String?  @unique // Clerk user id (ADR-0020); null while a Pending user
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Author (ADR-0013): null when no User made the write. A User is never deleted.
  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("UserCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("UserUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  activationLinks ActivationLink[] @relation("ActivationLinkUser")

  // Records this User is the Author of.
  createdUsers           User[]           @relation("UserCreated")
  updatedUsers           User[]           @relation("UserUpdated")
  createdActivationLinks ActivationLink[] @relation("ActivationLinkCreated")
  updatedActivationLinks ActivationLink[] @relation("ActivationLinkUpdated")
  createdGroups          Group[]          @relation("GroupCreated")
  updatedGroups          Group[]          @relation("GroupUpdated")
  createdGroupMembers    GroupMember[]    @relation("GroupMemberCreated")
  updatedGroupMembers    GroupMember[]    @relation("GroupMemberUpdated")

  groupMembers GroupMember[] @relation("GroupMemberUser")

  @@map("users")
}

model ActivationLink {
  id           Int      @id @default(autoincrement())
  userId       Int
  invitationId String   @unique // The Clerk invitation (ADR-0020); its url is never stored
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  Int? // Author (ADR-0013)
  updatedById  Int?
  createdBy    User?    @relation("ActivationLinkCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?    @relation("ActivationLinkUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  user User @relation("ActivationLinkUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activation_links")
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int? // Author (ADR-0013)
  updatedById Int?
  createdBy   User?    @relation("GroupCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("GroupUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  members GroupMember[]

  @@map("groups")
}

// The tie between a User and a Group. Written by PROJ-172 (Owners) and PROJ-177 (Viewers).
model GroupMember {
  id          Int       @id @default(autoincrement())
  groupId     Int
  userId      Int
  role        GroupRole
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById Int? // Author (ADR-0013)
  updatedById Int?
  createdBy   User?     @relation("GroupMemberCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("GroupMemberUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation("GroupMemberUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}
