NODE_ENV=development
PORT=3000

# Stack compartilhado docker-local (Postgres 16), role events_api
DATABASE_URL=postgresql://events_api:events_api123@localhost:5432/events_api_db
DATABASE_URL_TEST=postgresql://events_api:events_api123@localhost:5432/events_api_test
# Opcional: só para `prisma migrate diff --from-migrations` (checagem de drift do CI)
# SHADOW_DATABASE_URL=postgresql://events_api:events_api123@localhost:5432/events_api_shadow

# Verifica o token de sessão do Clerk (ADR-0020). Obrigatória com NODE_ENV=production.
# Sem ela, em dev nenhum token do Clerk é aceito (os testes usam um verificador falso).
# CLERK_SECRET_KEY=sk_test_...
# Opcional: chave pública PEM do Clerk (API keys → JWT public key). Verifica sem buscar o JWKS.
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----...
# Opcional: origens exatas aceitas no azp do token. Preenchida, recusa também token sem azp.
# CLERK_AUTHORIZED_PARTIES=https://painel.exemplo.com
# Assina o webhook do Clerk (POST /api/v1/webhooks/clerk, evento user.updated): o "Signing secret"
# do endpoint em Webhooks no dashboard. Obrigatória com NODE_ENV=production; sem ela, todo
# webhook responde 500 (os testes usam um segredo próprio).
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Opcionais: suítes de contrato do AuthVerifier e do InvitationIssuer contra uma instância de
# desenvolvimento do Clerk (clerk-*.spec.ts). O usuário precisa existir nela e ter email principal;
# a do InvitationIssuer só precisa da chave e revoga os convites que cria.
# CLERK_TEST_SECRET_KEY=sk_test_...
# CLERK_TEST_USER_ID=user_...

# Scalar em /api/v1/docs e OpenAPI em /api/v1/openapi
DOCS_ENABLED=true
# Opcional: login do Clerk na doc (API keys → Publishable key da instância de desenvolvimento).
# Sem ela, cole o token de sessão no Authorize. Com a CLERK_AUTHORIZED_PARTIES preenchida,
# inclua nela a origem da doc (http://localhost:3000).
# CLERK_PUBLISHABLE_KEY=pk_test_...

# Validade do Activation link (convite do Clerk) em dias inteiros (padrão: 7)
# ACTIVATION_LINK_TTL_DAYS=7
# Para onde o Activation link leva depois de aceito: o deep link do events-expo.
# Obrigatória com NODE_ENV=production; sem ela, em dev o Clerk usa a página padrão dele.
# ACTIVATION_REDIRECT_URL=eventsexpo://activate

# Origens exatas que o CORS aceita (ex.: o Panel), separadas por vírgula.
# Em dev, qualquer porta de localhost já é aceita.
# CORS_ORIGINS=https://painel.exemplo.com

# Contadores do rate limit (ADR-0007). Obrigatórias com NODE_ENV=production; sem elas,
# em dev os contadores ficam em memória. As duas vão juntas. Chaves com prefixo events-api:local.
# UPSTASH_REDIS_REST_URL=https://<banco>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
