generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  USER
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  passwordHash      String? // null while the User is a Pending user
  role              Role      @default(USER)
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // Author (ADR-0013): null when no User made the write. A User is never deleted.
  createdById       Int?
  updatedById       Int?
  createdBy         User?     @relation("UserCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User?     @relation("UserUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  activationLinks ActivationLink[] @relation("ActivationLinkUser")
  memberships     EventMember[]    @relation("EventMemberUser")

  // Records this User is the Author of.
  createdUsers           User[]           @relation("UserCreated")
  updatedUsers           User[]           @relation("UserUpdated")
  createdActivationLinks ActivationLink[] @relation("ActivationLinkCreated")
  updatedActivationLinks ActivationLink[] @relation("ActivationLinkUpdated")
  createdEvents          Event[]          @relation("EventCreated")
  updatedEvents          Event[]          @relation("EventUpdated")
  createdEventMembers    EventMember[]    @relation("EventMemberCreated")
  updatedEventMembers    EventMember[]    @relation("EventMemberUpdated")

  @@map("users")
}

model ActivationLink {
  id          Int       @id @default(autoincrement())
  userId      Int
  tokenHash   String    @unique // SHA-256 of the token; the token is never stored
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById Int? // Author (ADR-0013)
  updatedById Int?
  createdBy   User?     @relation("ActivationLinkCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("ActivationLinkUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  user User @relation("ActivationLinkUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activation_links")
}

enum EventType {
  WEDDING
  BIRTHDAY
  CORPORATE
  BABY_SHOWER
  PARTY
  OTHER
}

enum EventStatus {
  ACTIVE
  ARCHIVED
}

enum EventRole {
  OWNER
  MANAGER
  VIEWER
}

model Event {
  id           Int         @id @default(autoincrement())
  type         EventType
  status       EventStatus @default(ACTIVE)
  name         String
  slug         String      @unique // never changes
  siteUrl      String // origin only (scheme + host + port)
  startsAt     DateTime // UTC
  endsAt       DateTime?
  timezone     String      @default("America/Sao_Paulo")
  locale       String      @default("pt-BR")
  currency     String      @default("BRL")
  venueName    String?
  venueAddress String?
  city         String?
  mapsUrl      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  createdById  Int? // Author (ADR-0013)
  updatedById  Int?
  createdBy    User?       @relation("EventCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?       @relation("EventUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  members EventMember[]

  @@map("events")
}

model EventMember {
  id             Int       @id @default(autoincrement())
  eventId        Int
  userId         Int
  role           EventRole
  // At most one per Event: partial unique index created in the migration SQL (ADR-0003).
  isPrimaryOwner Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    Int? // Author (ADR-0013)
  updatedById    Int?
  createdBy      User?     @relation("EventMemberCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User?     @relation("EventMemberUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("EventMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_members")
}
