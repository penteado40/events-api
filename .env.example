NODE_ENV=development
PORT=3000

# Stack compartilhado docker-local (Postgres 16), role events_api
DATABASE_URL=postgresql://events_api:events_api123@localhost:5432/events_api_db
DATABASE_URL_TEST=postgresql://events_api:events_api123@localhost:5432/events_api_test
# Opcional: só para `prisma migrate diff --from-migrations` (checagem de drift do CI)
# SHADOW_DATABASE_URL=postgresql://events_api:events_api123@localhost:5432/events_api_shadow

# Mínimo de 32 caracteres. Gere um com: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Verifica o token de sessão do Clerk (ADR-0020). Obrigatória com NODE_ENV=production.
# Sem ela, em dev nenhum token do Clerk é aceito (os testes usam um verificador falso).
# CLERK_SECRET_KEY=sk_test_...

# Opcionais: suíte de contrato do AuthVerifier contra uma instância de desenvolvimento do Clerk
# (clerk-auth-verifier.spec.ts). O usuário precisa existir nela e ter email principal.
# CLERK_TEST_SECRET_KEY=sk_test_...
# CLERK_TEST_USER_ID=user_...

# Scalar em /api/v1/docs, OpenAPI em /api/v1/openapi e POST /api/v1/auth/token
DOCS_ENABLED=true

# Validade do Activation link em segundos (padrão: 7 dias)
# ACTIVATION_LINK_TTL=604800

# Origens exatas que o CORS aceita (ex.: o Panel), separadas por vírgula.
# Em dev, qualquer porta de localhost já é aceita.
# CORS_ORIGINS=https://painel.exemplo.com

# Contadores do rate limit (ADR-0007). Obrigatórias com NODE_ENV=production; sem elas,
# em dev os contadores ficam em memória. As duas vão juntas. Chaves com prefixo events-api:local.
# UPSTASH_REDIS_REST_URL=https://<banco>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
