generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  USER
}

enum GroupRole {
  OWNER
  VIEWER
}

enum EventState {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum EventItemState {
  DRAFT
  PUBLISHED
  CANCELLED
}

// The type of a Field, for good. A new type adds a value here and keeps its
// own value apart, so the Fields there are never migrate.
enum FieldKind {
  TEXT // Text, a list, a phone and a link too: in textValue
  PEOPLE // People: in event_item_field_people, in order
}

enum EventItemAudienceKind {
  ALL // "Todos": follows the list of Participants
  SELECTED // The people chosen, in event_item_audience_members
}

enum EmailKind {
  ACCOUNT_ACTIVATION_LINK
  GROUP_ACTIVATION_LINK
  GROUP_ACCESS
}

enum EmailStatus {
  SENT
  FAILED
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  phone         String // E.164 with the country code; contact only, never sign-in
  clerkId       String?   @unique // Clerk user id (ADR-0020); null while a Pending user
  role          Role      @default(USER)
  // Deactivated user: refused on every request (ADR-0020). Never deleted (ADR-0013).
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Author (ADR-0013): null when no User made the write. A User is never deleted.
  createdById   Int?
  updatedById   Int?
  createdBy     User?     @relation("UserCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User?     @relation("UserUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  activationLinks ActivationLink[] @relation("ActivationLinkUser")

  // Records this User is the Author of.
  createdUsers           User[]                    @relation("UserCreated")
  updatedUsers           User[]                    @relation("UserUpdated")
  createdActivationLinks ActivationLink[]          @relation("ActivationLinkCreated")
  updatedActivationLinks ActivationLink[]          @relation("ActivationLinkUpdated")
  createdGroups          Group[]                   @relation("GroupCreated")
  updatedGroups          Group[]                   @relation("GroupUpdated")
  createdGroupMembers    GroupMember[]             @relation("GroupMemberCreated")
  updatedGroupMembers    GroupMember[]             @relation("GroupMemberUpdated")
  createdTeams           Team[]                    @relation("TeamCreated")
  updatedTeams           Team[]                    @relation("TeamUpdated")
  createdEmailLogs       EmailLog[]                @relation("EmailLogCreated")
  updatedEmailLogs       EmailLog[]                @relation("EmailLogUpdated")
  createdEvents          Event[]                   @relation("EventCreated")
  updatedEvents          Event[]                   @relation("EventUpdated")
  createdChanges         Change[]                  @relation("ChangeCreated")
  updatedChanges         Change[]                  @relation("ChangeUpdated")
  createdEventItems      EventItem[]               @relation("EventItemCreated")
  updatedEventItems      EventItem[]               @relation("EventItemUpdated")
  createdParticipants    Participant[]             @relation("ParticipantCreated")
  updatedParticipants    Participant[]             @relation("ParticipantUpdated")
  createdAudienceMembers EventItemAudienceMember[] @relation("EventItemAudienceMemberCreated")
  updatedAudienceMembers EventItemAudienceMember[] @relation("EventItemAudienceMemberUpdated")
  createdFields          EventItemField[]          @relation("EventItemFieldCreated")
  updatedFields          EventItemField[]          @relation("EventItemFieldUpdated")
  createdFieldPeople     EventItemFieldPerson[]    @relation("EventItemFieldPersonCreated")
  updatedFieldPeople     EventItemFieldPerson[]    @relation("EventItemFieldPersonUpdated")

  groupMembers    GroupMember[]             @relation("GroupMemberUser")
  participants    Participant[]             @relation("ParticipantUser")
  audienceMembers EventItemAudienceMember[] @relation("EventItemAudienceMemberUser")
  fieldPeople     EventItemFieldPerson[]    @relation("EventItemFieldPersonUser")

  @@map("users")
}

model ActivationLink {
  id           Int      @id @default(autoincrement())
  userId       Int
  invitationId String   @unique // The Clerk invitation (ADR-0020); its url is never stored
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  Int? // Author (ADR-0013)
  updatedById  Int?
  createdBy    User?    @relation("ActivationLinkCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?    @relation("ActivationLinkUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  user User @relation("ActivationLinkUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activation_links")
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String
  hasHadOwner Boolean  @default(false) // Set with the first Owner; never unset (ADR-0017)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int? // Author (ADR-0013)
  updatedById Int?
  createdBy   User?    @relation("GroupCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("GroupUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  members GroupMember[]
  teams   Team[]
  events  Event[]

  @@map("groups")
}

// The tie between a User and a Group, with their role. Part of the Group's roster aggregate.
model GroupMember {
  id          Int       @id @default(autoincrement())
  groupId     Int
  userId      Int
  role        GroupRole
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById Int? // Author (ADR-0013)
  updatedById Int?
  createdBy   User?     @relation("GroupMemberCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("GroupMemberUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation("GroupMemberUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

// A named shortcut of a Group, kept by its Owners (Cantores, Banda). A flat list: the name is unique per Group, ignoring case.
// The case-insensitive unique index on (groupId, lower(name)) lives only in the migration: Prisma cannot model expression indexes.
model Team {
  id          Int      @id @default(autoincrement())
  groupId     Int
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int? // Author (ADR-0013)
  updatedById Int?
  createdBy   User?    @relation("TeamCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("TeamUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, name])
  @@map("teams")
}

// Any commitment of a Group (a rehearsal, a trip): only where and when; the rest are Event items.
// The dates are calendar days in the zone of the place, never converted to UTC (ADR-0016).
// A Finished event is derived (endDate before today in `timezone`), never stored.
// The CHECK that endDate is not before startDate lives only in the migration.
model Event {
  id            Int         @id @default(autoincrement())
  groupId       Int
  name          String
  place         String // Free text: a city or a venue
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  timezone      String // IANA zone of the place (America/Manaus)
  state         EventState  @default(DRAFT)
  // The state before the cancel (DRAFT or PUBLISHED) while CANCELLED, null otherwise
  cancelledFrom EventState?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdById   Int? // Author (ADR-0013)
  updatedById   Int?
  createdBy     User?       @relation("EventCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User?       @relation("EventUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  changes      Change[]
  items        EventItem[]
  participants Participant[]

  @@index([groupId, startDate])
  @@map("events")
}

// One step recorded on an Event or an Event item (the Change log): written in the same transaction as the change, never edited.
// The Author and the instant of the change are createdById and createdAt (ADR-0013).
// The reach is who the change reached before and after it, as User ids, kept as it was (ADR-0019):
// a User who leaves stays in it, so the arrays carry no foreign key.
model Change {
  id             Int      @id @default(autoincrement())
  eventId        Int
  // The Event item that changed; null for a Change of the Event. No foreign key: the Change outlives the item.
  eventItemId    Int?
  attribute      String // Event: name, place, period, state, itemOrder, participant; Event item: item (created, deleted), name, date, time, place, state, audience, field, fieldOrder, fieldHighlight
  before         Json
  after          Json
  productionOnly Boolean // Only the production sees it in the Change log
  reachBefore    Int[]
  reachAfter     Int[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    Int? // Author (ADR-0013)
  updatedById    Int?
  createdBy      User?    @relation("ChangeCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User?    @relation("ChangeUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  // Kept while the Event exists (amendment of ADR-0013).
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@map("changes")
}

// One attempt to send an email (Email log): internal, for diagnosis, never resent from here.
model EmailLog {
  id          Int         @id @default(autoincrement())
  kind        EmailKind
  recipient   String
  status      EmailStatus
  error       String? // What the provider answered, when the attempt failed
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById Int? // Author (ADR-0013): who triggered the email
  updatedById Int?
  createdBy   User?       @relation("EmailLogCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?       @relation("EmailLogUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([recipient])
  @@map("email_logs")
}

// A piece of the schedule of an Event. Date and time are local, never
// converted (ADR-0016); without a zone of its own, the Event's applies.
model EventItem {
  id            Int                   @id @default(autoincrement())
  eventId       Int
  name          String
  date          DateTime?             @db.Date // Calendar day; null for the General info
  time          String?               @db.VarChar(5) // HH:mm, local; only with a date
  placeName     String?
  placeAddress  String?
  placeTimezone String? // IANA zone of the place; null: the Event's applies
  state         EventItemState        @default(PUBLISHED)
  position      Int // Order of the production; only breaks the ties of the time. Last on create
  audienceKind  EventItemAudienceKind @default(ALL) // Whom it reaches; the people chosen in audienceMembers
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  createdById   Int? // Author (ADR-0013)
  updatedById   Int?
  createdBy     User?                 @relation("EventItemCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User?                 @relation("EventItemUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  event           Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  audienceMembers EventItemAudienceMember[]
  fields          EventItemField[]

  @@index([eventId])
  @@map("event_items")
}

// A Field of an Event item: a name and a value of one type only. Each type
// keeps its value in its own column or table (TEXT in textValue), so a new
// type comes with its own and never migrates the Fields there are.
model EventItemField {
  id          Int       @id @default(autoincrement())
  eventItemId Int
  kind        FieldKind
  name        String
  textValue   String? // The value of a TEXT Field; may be empty
  position    Int // Order of the production among the item's Fields. Last on create
  highlight   Boolean   @default(false) // In Highlight: the Field goes to the Summary
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById Int? // Author (ADR-0013)
  updatedById Int?
  createdBy   User?     @relation("EventItemFieldCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("EventItemFieldUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  eventItem EventItem              @relation(fields: [eventItemId], references: [id], onDelete: Cascade)
  people    EventItemFieldPerson[]

  @@index([eventItemId])
  @@map("event_item_fields")
}

// An entry of a people Field (kind PEOPLE), in the order the production gives
// (position): a User (userId), a Participant of its Event when put there,
// once per Field; or a loose name (name) of someone with no login, who only
// shows there, once per Field ignoring case. Exactly one of the two (a CHECK
// in the migration). The case-insensitive unique index on (fieldId,
// lower(name)) lives only in the migration: Prisma cannot model expression
// indexes.
model EventItemFieldPerson {
  id          Int      @id @default(autoincrement())
  fieldId     Int
  userId      Int? // A User; null for a loose name
  name        String? // A loose name, trimmed; null for a User
  position    Int // Order in the Field, from 1
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int? // Author (ADR-0013)
  updatedById Int?
  createdBy   User?    @relation("EventItemFieldPersonCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("EventItemFieldPersonUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  field EventItemField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  user  User?          @relation("EventItemFieldPersonUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([fieldId, userId])
  @@index([userId])
  @@map("event_item_field_people")
}

// A person chosen in the Audience of an Event item (audienceKind SELECTED),
// always a Participant of its Event: who leaves the Participants leaves here too.
model EventItemAudienceMember {
  id          Int      @id @default(autoincrement())
  eventItemId Int
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int? // Author (ADR-0013)
  updatedById Int?
  createdBy   User?    @relation("EventItemAudienceMemberCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("EventItemAudienceMemberUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  eventItem EventItem @relation(fields: [eventItemId], references: [id], onDelete: Cascade)
  user      User      @relation("EventItemAudienceMemberUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([eventItemId, userId])
  @@index([userId])
  @@map("event_item_audience_members")
}

// A User who goes to an Event: the list of Participants, a cut of the Group.
// Born as a copy of the Group members when the Event is created; who joins the
// Group later is not added. The id keeps the order of the list.
model Participant {
  id          Int      @id @default(autoincrement())
  eventId     Int
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int? // Author (ADR-0013)
  updatedById Int?
  createdBy   User?    @relation("ParticipantCreated", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("ParticipantUpdated", fields: [updatedById], references: [id], onDelete: Restrict)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("ParticipantUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("participants")
}
